{
  "imports": {
    "zod": "npm:zod@^4.1.0",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@^2.118.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@1.6.0",
    "unpdf": "npm:unpdf@2.1.0",
    "pdf-lib": "npm:pdf-lib@1.17.1",
    "mammoth": "npm:mammoth@1.13.0"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-env _shared tests",
    "check": "deno check **/*.ts",
    "build-seed": "deno run --allow-read --allow-write=../seed scripts/build-seed.ts",
    "check-config": "deno run --allow-read --allow-env scripts/check-ai-config.ts",
    "build-fixtures": "deno run --allow-read --allow-env --allow-write=tests/fixtures/contracts --allow-run=python3 scripts/build-fixtures.ts",
    "eval": "deno run --allow-read --allow-env --allow-net --allow-write=reports,tests/fixtures/llm-recordings,tests/fixtures/eval-baselines scripts/eval-extraction.ts",
    "list-todo-verify": "deno run --allow-read scripts/list-todo-verify.ts"
  },
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "lineWidth": 120,
    "singleQuote": true
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any"
      ]
    }
  }
}
